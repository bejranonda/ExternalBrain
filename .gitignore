next-env.d.ts
build/
coverage/
.env
.env.local
.env.*.local
.env.bak.*
# Catchall — never commit any backup variant of an env file regardless of suffix.
.env.local.bak*
.env.*.bak*
# DB / SQL backups — don't commit dumps either.
*.dump
*.sql.bak
.env.local.bak.db-*.sql
# rclone config — contains storage provider credentials. Generate via
# scripts/setup-backup-replicate.sh; store securely offline (1Password etc.).
deploy/rclone.conf
deploy/rclone.conf.bak.*
*.log
.DS_Store
.vscode/
.idea/
*.tsbuildinfo
prisma/migrations/dev.db*
packages/db/prisma/migrations/dev/
.pnpm-store/
# Generated by prisma generate (see packages/db/prisma/schema.prisma output)
packages/db/src/generated/
# Playwright E2E artefacts
playwright-report/
test-results/
.playwright-mcp/
.review-shots/
# Claude Code runtime artefacts (loop scheduler lock, agent state)
.claude/
# Deploy/reload log snapshots — captured by scripts/save-deploy-logs.sh
# before force-recreate to preserve incident evidence (#56 gap 1)
logs/snapshots/
.dev/

# Open-source: keep the author's host-specific guardrails + ops docs local (not published)
CLAUDE.local.md
GEMINI.local.md
AGENTS.local.md
docs/internal/

# Ad-hoc verification screenshots (Playwright MCP), never for commit
*-current.png
.playwright-mcp/
