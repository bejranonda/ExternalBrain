{
  "name": "@brain/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "//build-mem": "webpack compile peaks ~2.5GB; on hosts <8GB RAM with containers running, kernel may OOM-kill (exit 137). Fix options: (a) docker compose stop web mcp-server worker; pnpm build; (b) add 4GB swap once (sudo fallocate -l 4G /swapfile && sudo chmod 600 /swapfile && sudo mkswap /swapfile && sudo swapon /swapfile); (c) use ./scripts/reload.sh which builds inside Docker with its own budget. --webpack flag is required (see docs/KNOWLEDGE.md).",
    "dev": "next dev -p 3000",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@brain/core": "workspace:*",
    "@brain/db": "workspace:*",
    "@brain/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "redis": "^5.12.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.0.0",
    "globals": "^14.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
