{
  "name": "@brain/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "backfill:embeddings": "tsx src/backfill-embeddings.ts",
    "eval:kea": "tsx src/eval-kea.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@brain/core": "workspace:*",
    "@brain/db": "workspace:*",
    "@brain/types": "workspace:*",
    "pg-boss": "^12.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0"
  }
}
