    "pg-boss": "^12.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
