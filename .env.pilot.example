# =============================================================================
# Brain Platform — PILOT / LIVE deployment config
#
# Copy to .env on the deploy host and fill in every value marked "REPLACE".
# Then run `./scripts/deploy.sh` (localhost) or `./scripts/deploy-prod.sh`
# (public IP with TLS). The lockdown audit runs automatically at the end
# and refuses to report success until auth is configured.
#
# For local dev use .env.example instead — it defaults to ALLOW_DEV_AUTH=true
# so the stack works without a GitHub OAuth app. This pilot template is the
# opposite: secure-by-default, no anonymous access.
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL="postgresql://brain:brain@db:5432/brain"
POSTGRES_USER="brain"
POSTGRES_PASSWORD="brain"    # REPLACE with a strong password, rotate in the image
POSTGRES_DB="brain"
PG_BOSS_SCHEMA="pgboss"
NODE_ENV="production"

# --- Auth (OAuth mode — required for a pilot) --------------------------------
# 1. Create a GitHub OAuth app: https://github.com/settings/developers
#    Callback URL: https://<your-domain>/api/auth/callback/github
#    (or http://<host>:3000/api/auth/callback/github if no TLS yet)
# 2. Generate AUTH_SECRET:  openssl rand -base64 32
AUTH_URL="https://REPLACE-me.example.com"
AUTH_SECRET="REPLACE-me-openssl-rand-base64-32"
AUTH_GITHUB_ID="REPLACE-me-Iv1-xxxxx"
AUTH_GITHUB_SECRET="REPLACE-me-github-oauth-client-secret"
# Required on any non-localhost URL (IP-based deploy, Caddy, Cloudflare, etc.).
# Without this NextAuth returns "There was a problem with the server
# configuration" on /api/auth/*. Leave "true" unless you have a reason.
AUTH_TRUST_HOST="true"

# Explicit OFF for the dev shim. Leaving this "true" would accept anonymous
# requests as the first User row even with OAuth configured — catastrophic.
ALLOW_DEV_AUTH="false"
ALLOW_DEV_AUTH_IN_PRODUCTION="false"

# Emails auto-promoted to role=admin on first sign-in (comma-separated).
# The first person in this list is also the chicken-and-egg bypass for the
# voucher gate — they can bootstrap themselves without a voucher code.
ADMIN_EMAILS="you@yourteam.com"

# Require a voucher for every new signup. Flip to "false" only during a
# short open-signup window with explicit business sign-off.
REGISTRATION_REQUIRES_VOUCHER="true"

# --- Public hostnames (deploy-prod.sh + Caddy) -------------------------------
BRAIN_PUBLIC_HOSTNAME="brain.example.com"          # REPLACE
BRAIN_MCP_PUBLIC_HOSTNAME="mcp.brain.example.com"  # REPLACE — can equal the above if you want a /mcp subpath
CADDY_EMAIL="ops@example.com"                      # REPLACE — ACME registration

# --- LLM / embeddings --------------------------------------------------------
# Minimum viable: one of the following blocks.
#   A) Google Gemini (free tier exists):
GOOGLE_GEMINI_API_KEY=""
EMBEDDING_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS="1536"
ORACLE_MODEL="gemini-2.0-flash-exp"
#   B) OpenAI — uncomment and fill:
# OPENAI_API_KEY=""
# EMBEDDING_MODEL="text-embedding-3-small"
# ORACLE_MODEL="gpt-4o-mini"
#   C) Anthropic / Z.ai GLM — uncomment:
# ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL=""         # leave empty for api.anthropic.com; set to Z.ai endpoint if using GLM
# ORACLE_MODEL="claude-sonnet-4-6"

# --- Cost caps + rate limits (per user, per window) --------------------------
MAX_ORACLE_COST_USD_PER_DAY="10.00"
MAX_KEA_COST_USD_PER_SESSION="0.05"
RATE_LIMIT_ORACLE_PER_DAY="100"
RATE_LIMIT_KEA_PER_HOUR="60"
RATE_LIMIT_MCP_PER_MINUTE="200"

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"
LOG_LEVEL="info"

# --- Durable rate limit across replicas (optional, strongly recommended) -----
# Without REDIS_URL the proxy limiter is per-process in-memory — fine for one
# container, lossy across restarts. Any real pilot should wire Redis.
REDIS_URL=""

# --- Host ports (compose only, unused in Caddy mode) -------------------------
WEB_HOST_PORT="3000"
MCP_HOST_PORT="3100"
POSTGRES_HOST_PORT="5432"

# --- Seed policy -------------------------------------------------------------
# Real-user deploys should NOT seed the Alex persona — a pilot user joining a
# brand-new deployment should see an empty Brain, not a demo account's.
SKIP_SEED="true"
