# =============================================================================
# External Brain — environment template
# =============================================================================
# Copy to `.env` at the repo root. Values below are either sensible defaults
# or empty placeholders safe to commit. Fill in the ones marked REQUIRED for
# the flow you want to run; leave the rest untouched unless you know why.
#
# Two deploy modes share this file:
#
#   • Docker Compose (scripts/deploy.sh) — `DATABASE_URL` uses host `db`
#     (the compose service name) and the POSTGRES_* + *_HOST_PORT vars
#     control the container.
#
#   • Local dev (`pnpm turbo run dev`) — flip `DATABASE_URL` to localhost.
#     POSTGRES_* and *_HOST_PORT are ignored.
#
# NEVER commit a filled-in `.env`. It's gitignored.
# =============================================================================

# --- Database -----------------------------------------------------------------
# REQUIRED. Compose default (container-to-container):
DATABASE_URL="postgresql://brain:brain@db:5432/brain"
# Local dev (host-to-host):
# DATABASE_URL="postgresql://brain:brain@localhost:5432/brain"
# After provisioning: psql $DATABASE_URL -c "CREATE EXTENSION IF NOT EXISTS vector;"

# Docker-compose credentials (ignored for local dev).
# ⚠️ CHANGE POSTGRES_PASSWORD before any non-local deploy. The default below is
#    for localhost-only dev; an exposed DB with this password = full data access.
POSTGRES_USER="brain"
POSTGRES_PASSWORD="brain"
POSTGRES_DB="brain"

# --- LLM Providers -----------------------------------------------------------
OPENAI_API_KEY=""                    # required: embeddings (text-embedding-3-small)
ANTHROPIC_API_KEY=""                 # Oracle key — also accepts Z.ai / Anthropic-compat keys

# Optional: route Anthropic SDK calls through an Anthropic-compatible gateway
# such as Z.ai (GLM 4.6 / 5.1), AWS Bedrock proxy, or Vertex anthropic.
# When set, ANY ORACLE_MODEL name is passed through as-is (no `claude-*` check).
#
#   ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"
#   ANTHROPIC_API_KEY="<your z.ai key>"
#   ORACLE_MODEL="glm-4.6"            # or "glm-5.1"
#
ANTHROPIC_BASE_URL=""

# Route embeddings through an OpenAI-compatible gateway.
# When set, the embed() client uses this baseURL + the key resolution
# chain:  EMBEDDING_API_KEY → GOOGLE_GEMINI_API_KEY → OPENAI_API_KEY
#         → ANTHROPIC_API_KEY
#
# -- Option A: Google Gemini (recommended, free tier, 1536 dim native) --
#   EMBEDDING_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   GOOGLE_GEMINI_API_KEY="<your gemini key from aistudio.google.com>"
#   EMBEDDING_MODEL="gemini-embedding-001"
#   EMBEDDING_DIMENSIONS="1536"     # supported: 128..3072; 1536 matches DB column
#
# -- Option B: Alibaba DashScope Qwen3 (paid, general-purpose sk-… key) --
#   EMBEDDING_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"  # Singapore
# # EMBEDDING_BASE_URL="https://dashscope-us.aliyuncs.com/compatible-mode/v1"    # Virginia
# # EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"       # Beijing
#   EMBEDDING_API_KEY="<your dashscope sk-… key from bailian.console.aliyun.com>"
#   EMBEDDING_MODEL="text-embedding-v4"
#   EMBEDDING_DIMENSIONS="1536"
#
# -- Option C: OpenAI (default) --
#   leave EMBEDDING_BASE_URL empty + set OPENAI_API_KEY + EMBEDDING_MODEL=text-embedding-3-small
#
# Note: Z.ai's PaaS v4 does NOT expose an embedding endpoint; GLM chat
# routing via ANTHROPIC_BASE_URL (above) does not cover embeddings.
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""
GOOGLE_GEMINI_API_KEY=""

# --- Model selection ---------------------------------------------------------
# If both ANTHROPIC_BASE_URL and EMBEDDING_BASE_URL are set to Z.ai + DashScope,
# the recommended defaults below give you a fully non-OpenAI stack.
#
# KEA_MODEL routes (packages/core/src/kea.ts) — set the matching API key:
#   • glm-* / qwen-*               → DashScope        — needs DASHSCOPE_API_KEY
#   • claude-*                     → Anthropic        — needs ANTHROPIC_API_KEY
#   • anything else (gpt-* etc.)   → OpenAI           — needs OPENAI_API_KEY
# If the matching key is unset, kea.extract fails with a clear error
# naming the right variable. Default below routes to DashScope.
KEA_MODEL="glm-4.5-air"              # glm-4.5 | glm-4.5-air | glm-4.5-flash | qwen3-coder | claude-haiku-4-5
DASHSCOPE_API_KEY=""                 # required if KEA_MODEL starts with glm-* or qwen-*
ORACLE_MODEL="glm-5.1"               # glm-5.1 | glm-4.6 | glm-4.5 | claude-sonnet-4-6 | gpt-4o
EMBEDDING_MODEL="text-embedding-v4"  # DashScope Qwen3 · text-embedding-3-small (OpenAI)
EMBEDDING_DIMENSIONS="1536"

# --- Autoskill LLM classifier (optional; default off) ---
# When true, the worker classifies post-session signals (rules|knowledge|ignore)
# with an LLM instead of keyword heuristics. No DB migration. Routes through the
# same provider dispatch as KEA_MODEL.
AUTOSKILL_LLM_CLASSIFIER="false"
# AUTOSKILL_SHADOW="false"           # run the classifier + log agreement WITHOUT acting on it
#                                    # (gather agreement data before flipping the flag). Both off
#                                    # = zero extra LLM calls (cost-neutral default).
# AUTOSKILL_MODEL=""                 # classifier model (falls back to KEA_MODEL, then qwen3-coder)
# AUTOSKILL_CLASSIFY_MAX="12"        # max signals per batched call; overflow routes via heuristic
# AUTOSKILL_FEWSHOT_TOKEN_BUDGET="1500"  # token budget for user-derived few-shot examples

# --- Feature flags -----------------------------------------------------------
# NOTE: KEA_ENABLED, AUTOSKILL_ENABLED, ORACLE_ENABLED, MCP_ENABLED are all
# WIRED operator kill-switches. The rest are aspirational — documented for
# future toggling but not yet read by runtime code. Leave defaults as-is
# unless you know the flag is actually consumed by the module you care about.
KEA_ENABLED="true"                        # WIRED — worker skips KEA if false
AUTOSKILL_ENABLED="true"                  # WIRED — worker skips autoskill if false
ORACLE_ENABLED="true"                     # WIRED — /api/oracle + /api/oracle/stream return 503 when false (#56 gap 3)
MCP_ENABLED="true"                        # WIRED — mcp-server /mcp returns 503 when false; /health stays open (#56 gap 3)
SEMANTIC_RETRIEVAL_ENABLED="true"         # aspirational — kra.ts runs unconditionally
OUTCOME_FEEDBACK_ENABLED="true"           # aspirational — feedback always recorded
COMMUNITY_PUBLISHING_ENABLED="false"      # aspirational — no community-publish flow yet
LIVESYNC_BRIDGE_ENABLED="false"           # aspirational — sync-bridge is scaffolded, not wired

# --- Auth --------------------------------------------------------------------
# Four mutually exclusive modes (resolved in this priority order):
#
#   A) Credentials (phase-1 pilot default): set ADMIN_USERNAME +
#      ADMIN_PASSWORD_HASH. A single admin account signs in with username
#      + bcrypt-hashed password — no OAuth App required. Generate the hash
#      with `pnpm hash-admin-password '<plaintext>'` and paste the output
#      into ADMIN_PASSWORD_HASH (single-quoted — bcrypt uses `$`).
#
#   B) OAuth (future pilot invitees): set AUTH_GITHUB_ID + AUTH_GITHUB_SECRET +
#      AUTH_SECRET. Users sign in with GitHub. New signups require a voucher
#      code unless REGISTRATION_REQUIRES_VOUCHER=false. Coexists with A —
#      both buttons render on /signin when both are configured.
#
#   C) Dev shim (local dev ONLY): set ALLOW_DEV_AUTH=true. The app uses the
#      DEV_USER_ID env (or the first User row) as the authenticated user for
#      every request. Refused in NODE_ENV=production unless you ALSO set
#      ALLOW_DEV_AUTH_IN_PRODUCTION=true (only intended for VPN-only demos).
#
#   D) Unconfigured (default): none of the above. Every request returns
#      503 `auth_not_configured`. This is the secure-by-default lockdown —
#      a freshly-deployed VM does not serve anyone's data until the operator
#      chooses mode A, B, or C.
#
# IMPORTANT: AUTH_URL must match the EXACT origin users hit in the browser
# (scheme + host + port). NextAuth uses it to construct the post-sign-in
# redirect — leaving the localhost default on a remote VM bounces the
# user from https://your-host.example.com/signin to http://localhost:3000/
# after a successful login. trustHost: true does NOT override an explicit
# AUTH_URL. Set to:
#   - http://localhost:3000               for `pnpm turbo run dev` only
#   - http://<vm-ip>:3000                 for IP-based test access
#   - https://brain.example.com           when behind Caddy / Cloudflare TLS
AUTH_URL="http://localhost:3000"
# Set true when serving on anything other than localhost (IP-based deploy,
# Caddy, Cloudflare, etc.). Without it NextAuth 500s on /api/auth/* with
# "There was a problem with the server configuration."
AUTH_TRUST_HOST="true"
AUTH_SECRET=""                       # openssl rand -base64 32

# Mode A — single admin account stored in env. Leave empty for modes B/C/D.
# Example (do NOT use these values — generate your own hash):
#   ADMIN_USERNAME="admin"
#   ADMIN_PASSWORD_HASH='$2b$12$PasteOutputOfHashAdminPasswordHere.............'
#   ADMIN_EMAILS="you@yourteam.com"      # see ADMIN_EMAILS below — same key for both modes
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""

# Mode B — GitHub OAuth. Leave empty if you're on credentials (Mode A) only.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Mode C opt-in. Do NOT set this on a public-internet deployment.
ALLOW_DEV_AUTH="false"

# Single canonical admin-email key (#39). Comma-separated list:
#   - In Mode B (OAuth), every email here is auto-promoted to role='admin'
#     on first sign-in.
#   - In Mode A (Credentials), the FIRST entry seeds the admin User row's
#     email column. Synthesised from the username if empty.
#
# A legacy singular `ADMIN_EMAIL` is still accepted by the credentials
# code path with a deprecation warning, but new deployments should set
# ADMIN_EMAILS only. scripts/deploy-prod.sh also promotes singular →
# plural at script load time so existing operators stay unblocked.
ADMIN_EMAILS=""

# Voucher gate. True (default) refuses new-user signups without a valid
# VoucherCode redemption. Governs BOTH self-service paths:
#   - GitHub OAuth signup (Mode B), and
#   - email + password self-service registration via /signin?mode=register
#     (POST /api/auth/register), available in Mode A.
# So this is the single knob for "is open signup allowed on this deployment".
# Set to "false" for a pre-launch open-signup window (anyone can register, no
# voucher needed) — only do this if you accept public account creation.
REGISTRATION_REQUIRES_VOUCHER="true"

# Shim fallback (Mode B). Leave empty to use the first User row (the seed's Alex).
DEV_USER_ID=""

# --- MCP server --------------------------------------------------------------
MCP_TRANSPORT="http"                 # stdio | http. Compose uses http.
MCP_SERVER_HTTP_PORT="3100"
MCP_TOKEN_SECRET=""                  # openssl rand -base64 32 — not yet required

# --- Host ports (Docker compose only) ----------------------------------------
# These ports bind to 127.0.0.1 by default (see *_HOST_BIND in docker-compose).
# Public access goes through Caddy/TLS (:443) — never expose 5432/3000/3100 on
# 0.0.0.0. Only set *_HOST_BIND to something other than 127.0.0.1 behind a proxy.
WEB_HOST_PORT="3000"
MCP_HOST_PORT="3100"
POSTGRES_HOST_PORT="5432"
# WEB_HOST_BIND="127.0.0.1"
# MCP_HOST_BIND="127.0.0.1"
# POSTGRES_HOST_BIND="127.0.0.1"

# --- Production (deploy/docker-compose.prod.yml + ./scripts/deploy-prod.sh) ---
# Set these only for a bare-VM public-internet deploy. Caddy terminates TLS
# via Let's Encrypt; ACME needs ports 80 + 443 open in the VM firewall.
BRAIN_PUBLIC_HOSTNAME=""           # e.g. brain.example.com — DNS A record must exist
BRAIN_MCP_PUBLIC_HOSTNAME=""       # e.g. mcp.brain.example — can equal the above
CADDY_EMAIL=""                     # address for ACME registration
# Opt-in to dev-auth shim in production deployments behind a VPN only:
ALLOW_DEV_AUTH_IN_PRODUCTION="false"
# Skip the Alex-persona seed on real-user deploys:
SKIP_SEED="false"

# --- Object storage (not yet wired — Phase 2 item) ---------------------------
STORAGE_PROVIDER="local"             # local | s3 | r2
STORAGE_BUCKET="brain-sessions"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- Background jobs ---------------------------------------------------------
PG_BOSS_SCHEMA="pgboss"

# --- LiveSync bridge (optional) ----------------------------------------------
COUCHDB_URL=""                       # e.g. http://admin:pw@localhost:5984
COUCHDB_DB_PREFIX="brain-"

# --- Observability -----------------------------------------------------------
LOG_LEVEL="info"                     # pino level: trace|debug|info|warn|error|fatal
# Sentry error reporting (Wave 2). No-op when DSN is empty.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"        # 0..1 — leave at 0 until you've sized the volume

# --- Redis (Wave 2 — multi-replica rate-limit state) -------------------------
# Dev / single-host deploys can leave empty; the proxy falls back to an
# in-process Map. Production docker-compose provides `redis://redis:6379`.
REDIS_URL=""

# --- Email (optional — falls back to manual-link UX when disabled) ----------
# Set EMAIL_PROVIDER=resend to enable automated invite + password-reset emails.
# When unset or "disabled", invite links are returned in the API response only
# (copy-paste to email/Slack manually). Password reset is then operator-assisted.
#
# Step-by-step:
#   1. Sign up at https://resend.com, verify a sending domain.
#   2. Create an API key with "Sending access".
#   3. Set EMAIL_API_KEY to the key value.
#   4. Set EMAIL_FROM to "Your Name <noreply@yourdomain.com>".
#   5. Set EMAIL_PROVIDER=resend and restart the web container.
#   6. Smoke-test: create an invite via /settings/org — the API response will
#      include `"emailSent": true` when delivery succeeded.
EMAIL_PROVIDER="disabled"            # "resend" | "disabled"
EMAIL_API_KEY=""                     # Resend API key (re: api.resend.com)
EMAIL_FROM="External Brain <noreply@brain-dev.example.com>"
EMAIL_REPLY_TO=""                    # optional; defaults to EMAIL_FROM

# --- Rate limits -------------------------------------------------------------
RATE_LIMIT_ORACLE_PER_DAY="100"
RATE_LIMIT_KEA_PER_HOUR="60"
RATE_LIMIT_MCP_PER_MINUTE="200"

# --- Cost guards -------------------------------------------------------------
MAX_KEA_COST_USD_PER_SESSION="0.05"
MAX_ORACLE_COST_USD_PER_DAY="10.00"  # enforced by OracleCostLedger (packages/core/src/cost.ts)

# --- Backup replication (production) -----------------------------------------
# Off-host replication of the postgres-backup-local sidecar's dumps via rclone.
# When unset, backups remain on-host only (disk-failure risk — see
# docs/KNOWN_ISSUES.md "Backups are on-host only").
#
# Setup:
#   1. Run scripts/setup-backup-replicate.sh — creates deploy/rclone.conf.
#   2. Set BACKUP_REMOTE to your bucket path (examples below).
#   3. Add "backup-replicate" to COMPOSE_PROFILES and re-deploy.
#
# Provider examples:
#   Cloudflare R2:  BACKUP_REMOTE="s3-r2:my-bucket/brain-prod"
#   AWS S3:         BACKUP_REMOTE="s3-aws:my-bucket/brain-prod"
#   Backblaze B2:   BACKUP_REMOTE="b2:my-bucket/brain-prod"
#
# See docs/RUNBOOK.md §"Off-host backup replication" for full instructions.
BACKUP_REMOTE=""                    # e.g. "s3-r2:my-bucket/brain-prod"
BACKUP_INTERVAL="3600"              # seconds between syncs (default 1 hour)
